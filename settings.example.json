{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "$HOME/.claude/gates/hooks/live_clock.py", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$HOME/.claude/gates/hooks/deny_list.py", "timeout": 10 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          { "type": "command", "command": "$HOME/.claude/gates/hooks/failure_trace.py", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "$HOME/.claude/gates/hooks/stop_chain.py", "timeout": 45 }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          { "type": "command", "command": "$HOME/.claude/gates/hooks/stopfailure_alert.py", "timeout": 15 }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "user_settings",
        "hooks": [
          { "type": "command", "command": "$HOME/.claude/gates/hooks/config_tamper.py", "timeout": 10 }
        ]
      }
    ]
  }
}
